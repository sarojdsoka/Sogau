* {
    bg:     rgba(10,10,10,0.95);
    fg:     #e8e8e8;
    red:    rgba(211,47,47,0.45);
    border: rgba(211,47,47,0.4);
    input:  rgba(20,20,20,0.8);
    element: rgba(20,20,20,0.5);
}

window {
    border-radius: 16px;
    background-color: transparent;
    width: 480px;
    location: center;
}

mainbox {
    spacing: 0;
    padding: 12px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 16px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 0;
    margin: 0 0 8px 0;
    padding: 12px;
    background-color: @input;
    border-radius: 10px;
    children: [ "entry" ];
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search network...";
    placeholder-color: rgba(232,232,232,0.35);
}

listview {
    spacing: 4px;
    layout: vertical;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    spacing: 8px;
    padding: 10px 14px;
    margin: 2px 0;
    border-radius: 10px;
    background-color: @element;
    text-color: @fg;
    cursor: pointer;
    children: [ "element-icon", "element-text" ];
}

element normal.active {
    background-color: rgba(211,47,47,0.25);
}

element selected.normal {
    background-color: @red;
    text-color: #ffffff;
}

element-icon {
    background-color: inherit;
    size: 20px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
